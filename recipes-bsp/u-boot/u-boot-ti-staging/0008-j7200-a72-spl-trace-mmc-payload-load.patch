From 2ea23ad49e8d723d1e4e6adfc1fa27a01b772808 Mon Sep 17 00:00:00 2001
From: Boot Time Experiment <boot-time@example.com>
Date: Mon, 7 Sep 2026 18:00:00 +0900
Subject: [PATCH] J7200: trace A72 SPL MMC payload load

Use fixed strings and single local integer values to trace the A72 SPL path
which initializes the SD card and loads u-boot.img. Avoid dereferencing MMC
fields or using pointer and string conversions in the diagnostic path. R5 SPL
and full U-Boot are unaffected.

Signed-off-by: Boot Time Experiment <boot-time@example.com>
---
 common/spl/spl_mmc.c | 30 ++++++++++++++++++++++++++++++
 1 file changed, 30 insertions(+)

diff --git a/common/spl/spl_mmc.c b/common/spl/spl_mmc.c
index ea2ec69dcda..87cccd450ab 100644
--- a/common/spl/spl_mmc.c
+++ b/common/spl/spl_mmc.c
@@ -375,14 +375,29 @@ int spl_mmc_load(struct spl_image_info *spl_image,
 
 	/* Perform peripheral init only once for an mmc device */
 	mmc_dev = spl_mmc_get_device_index(bootdev->boot_device);
+#if defined(CONFIG_SPL_BUILD) && defined(CONFIG_TARGET_J7200_A72_EVM)
+	printf("BOOT_DIAG: A72_SPL: loader entered\n");
+	printf("BOOT_DIAG: A72_SPL: mmc_dev=%d\n", mmc_dev);
+#endif
 	log_debug("boot_device=%d, mmc_dev=%d\n", bootdev->boot_device,
 		  mmc_dev);
 	if (!mmc || spl_mmc_get_mmc_devnum(mmc) != mmc_dev) {
 		ret = spl_mmc_find_device(&mmc, mmc_dev);
+#if defined(CONFIG_SPL_BUILD) && defined(CONFIG_TARGET_J7200_A72_EVM)
+		printf("BOOT_DIAG: A72_SPL: find device returned\n");
+		printf("BOOT_DIAG: A72_SPL: find device ret=%d\n", ret);
+#endif
 		if (ret)
 			return ret;
 
+#if defined(CONFIG_SPL_BUILD) && defined(CONFIG_TARGET_J7200_A72_EVM)
+		printf("BOOT_DIAG: A72_SPL: before mmc_init\n");
+#endif
 		ret = mmc_init(mmc);
+#if defined(CONFIG_SPL_BUILD) && defined(CONFIG_TARGET_J7200_A72_EVM)
+		printf("BOOT_DIAG: A72_SPL: mmc_init returned\n");
+		printf("BOOT_DIAG: A72_SPL: mmc_init ret=%d\n", ret);
+#endif
 		if (ret) {
 			mmc = NULL;
 			printf("spl: mmc init failed with error: %d\n", ret);
@@ -390,7 +405,15 @@ int spl_mmc_load(struct spl_image_info *spl_image,
 		}
 	}
 
+#if defined(CONFIG_SPL_BUILD) && defined(CONFIG_TARGET_J7200_A72_EVM)
+	printf("BOOT_DIAG: A72_SPL: after mmc_init\n");
+	printf("BOOT_DIAG: A72_SPL: before get boot mode\n");
+#endif
 	boot_mode = spl_mmc_boot_mode(mmc, bootdev->boot_device);
+#if defined(CONFIG_SPL_BUILD) && defined(CONFIG_TARGET_J7200_A72_EVM)
+	printf("BOOT_DIAG: A72_SPL: after get boot mode\n");
+	printf("BOOT_DIAG: A72_SPL: boot mode=%u\n", boot_mode);
+#endif
 	ret = -EINVAL;
 	switch (boot_mode) {
 	case MMCSD_MODE_EMMCBOOT:
@@ -436,7 +459,14 @@ int spl_mmc_load(struct spl_image_info *spl_image,
 	case MMCSD_MODE_FS:
 		debug("spl: mmc boot mode: fs\n");
 
+#if defined(CONFIG_SPL_BUILD) && defined(CONFIG_TARGET_J7200_A72_EVM)
+		printf("BOOT_DIAG: A72_SPL: before FAT/FIT load\n");
+#endif
 		ret = spl_mmc_do_fs_boot(spl_image, bootdev, mmc, filename);
+#if defined(CONFIG_SPL_BUILD) && defined(CONFIG_TARGET_J7200_A72_EVM)
+		printf("BOOT_DIAG: A72_SPL: after FAT/FIT load\n");
+		printf("BOOT_DIAG: A72_SPL: FAT/FIT load ret=%d\n", ret);
+#endif
 		if (!ret)
 			return 0;
 

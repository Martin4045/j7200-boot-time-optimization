From c173637670430663a5997c65cd5af9f275000010 Mon Sep 17 00:00:00 2001
From: G Spark <gspark@example.com>
Date: Mon, 7 Sep 2026 19:00:00 +0900
Subject: [PATCH] j7200: trace direct SD boot command

The A72 SPL-to-payload handoff and full U-Boot initialization reach
main_loop. Add target- and argument-specific diagnostics around only the
fixed SD boot command. Temporarily bypass the silent flag for each marker
and restore it immediately afterward.

Signed-off-by: G Spark <gspark@example.com>
---
 arch/arm/lib/bootm.c |  1 +
 cmd/booti.c          |  8 ++++++++
 cmd/fs.c             | 36 +++++++++++++++++++++++++++++++++++-
 cmd/mmc.c            | 26 +++++++++++++++++++++++++-
 cmd/nvedit.c         | 20 +++++++++++++++++++-
 cmd/part.c           | 26 ++++++++++++++++++++++++--
 common/autoboot.c    | 14 ++++++++++++++
 7 files changed, 131 insertions(+), 5 deletions(-)

diff --git a/arch/arm/lib/bootm.c b/arch/arm/lib/bootm.c
index fb0f1206be..1a62c7ef00 100644
--- a/arch/arm/lib/bootm.c
+++ b/arch/arm/lib/bootm.c
@@ -104,6 +104,7 @@ static void announce_and_cleanup(struct bootm_headers *images, int fake)
 
 	/* Preserve the final diagnostic marker even when normal output is silent. */
 	gd->flags &= ~GD_FLG_SILENT;
+	printf("BOOT_DIAG: A72_UBOOT: before BOOTLOADER_DONE_US\n");
 	printf("BOOT_METRIC: BOOTLOADER_DONE_US=%llu\n", done_us);
 	if (was_silent)
 		gd->flags |= GD_FLG_SILENT;
diff --git a/cmd/booti.c b/cmd/booti.c
index 43e79e87201..b28fa3fe659 100644
--- a/cmd/booti.c
+++ b/cmd/booti.c
@@ -106,6 +106,14 @@ int do_booti(struct cmd_tbl *cmdtp, int flag, int argc, char *const argv[])
 	int states;
 	int ret;
 
+#if !defined(CONFIG_XPL_BUILD) && defined(CONFIG_TARGET_J7200_A72_EVM)
+	ulong flags = gd->flags;
+
+	gd->flags &= ~GD_FLG_SILENT;
+	printf("BOOT_DIAG: A72_UBOOT: immediately before booti\n");
+	gd->flags = flags;
+#endif
+
 	/* Consume 'booti' */
 	argc--; argv++;
 
diff --git a/cmd/fs.c b/cmd/fs.c
index 3d7e06d6f1e..068019d0863 100644
--- a/cmd/fs.c
+++ b/cmd/fs.c
@@ -7,6 +7,27 @@
 
 #include <command.h>
 #include <fs.h>
+#include <asm/global_data.h>
+
+DECLARE_GLOBAL_DATA_PTR;
+
+#if !defined(CONFIG_XPL_BUILD) && defined(CONFIG_TARGET_J7200_A72_EVM)
+static void j7200_diag_load(const char *name, bool before, int ret)
+{
+	ulong flags = gd->flags;
+
+	gd->flags &= ~GD_FLG_SILENT;
+	if (!strcmp(name, "/boot/Image"))
+		printf(before ? "BOOT_DIAG: A72_UBOOT: before load Image\n" :
+		       "BOOT_DIAG: A72_UBOOT: after load Image\n");
+	else
+		printf(before ? "BOOT_DIAG: A72_UBOOT: before load DTB\n" :
+		       "BOOT_DIAG: A72_UBOOT: after load DTB\n");
+	if (!before)
+		printf("BOOT_DIAG: A72_UBOOT: load ret=%d\n", ret);
+	gd->flags = flags;
+}
+#endif
 
 static int do_size_wrapper(struct cmd_tbl *cmdtp, int flag, int argc,
 			   char *const argv[])
@@ -25,7 +46,21 @@ U_BOOT_CMD(
 static int do_load_wrapper(struct cmd_tbl *cmdtp, int flag, int argc,
 			   char *const argv[])
 {
-	return do_load(cmdtp, flag, argc, argv, FS_TYPE_ANY);
+	int ret;
+#if !defined(CONFIG_XPL_BUILD) && defined(CONFIG_TARGET_J7200_A72_EVM)
+	bool trace = argc >= 5 &&
+		(!strcmp(argv[4], "/boot/Image") ||
+		 !strcmp(argv[4], "/boot/dtb/ti/k3-j7200-common-proc-board.dtb"));
+
+	if (trace)
+		j7200_diag_load(argv[4], true, 0);
+#endif
+	ret = do_load(cmdtp, flag, argc, argv, FS_TYPE_ANY);
+#if !defined(CONFIG_XPL_BUILD) && defined(CONFIG_TARGET_J7200_A72_EVM)
+	if (trace)
+		j7200_diag_load(argv[4], false, ret);
+#endif
+	return ret;
 }
 
 U_BOOT_CMD(
diff --git a/cmd/mmc.c b/cmd/mmc.c
index fe7899ec793..3bdb782eaa2 100644
--- a/cmd/mmc.c
+++ b/cmd/mmc.c
@@ -15,10 +15,25 @@
 #include <sparse_format.h>
 #include <image-sparse.h>
 #include <vsprintf.h>
+#include <asm/global_data.h>
 #include <linux/ctype.h>
 
+DECLARE_GLOBAL_DATA_PTR;
+
 static int curr_device = -1;
 
+#if !defined(CONFIG_XPL_BUILD) && defined(CONFIG_TARGET_J7200_A72_EVM)
+static void j7200_diag_mmc_dev(int ret)
+{
+	ulong flags = gd->flags;
+
+	gd->flags &= ~GD_FLG_SILENT;
+	printf("BOOT_DIAG: A72_UBOOT: after mmc dev 1\n");
+	printf("BOOT_DIAG: A72_UBOOT: mmc dev ret=%d\n", ret);
+	gd->flags = flags;
+}
+#endif
+
 static void print_mmcinfo(struct mmc *mmc)
 {
 	int i;
@@ -1268,6 +1283,11 @@ static int do_mmcops(struct cmd_tbl *cmdtp, int flag, int argc,
 		     char *const argv[])
 {
 	struct cmd_tbl *cp;
+	int ret;
+#if !defined(CONFIG_XPL_BUILD) && defined(CONFIG_TARGET_J7200_A72_EVM)
+	bool trace_dev = argc == 3 && !strcmp(argv[1], "dev") &&
+			 !strcmp(argv[2], "1");
+#endif
 
 	cp = find_cmd_tbl(argv[1], cmd_mmc, ARRAY_SIZE(cmd_mmc));
 
@@ -1288,7 +1308,12 @@ static int do_mmcops(struct cmd_tbl *cmdtp, int flag, int argc,
 			return CMD_RET_FAILURE;
 		}
 	}
-	return cp->cmd(cmdtp, flag, argc, argv);
+	ret = cp->cmd(cmdtp, flag, argc, argv);
+#if !defined(CONFIG_XPL_BUILD) && defined(CONFIG_TARGET_J7200_A72_EVM)
+	if (trace_dev)
+		j7200_diag_mmc_dev(ret);
+#endif
+	return ret;
 }
 
 U_BOOT_CMD(
diff --git a/cmd/nvedit.c b/cmd/nvedit.c
index 392f90f8698..2152034b621 100644
--- a/cmd/nvedit.c
+++ b/cmd/nvedit.c
@@ -44,6 +44,18 @@
 DECLARE_GLOBAL_DATA_PTR;
+
+#if !defined(CONFIG_XPL_BUILD) && defined(CONFIG_TARGET_J7200_A72_EVM)
+static void j7200_diag_bootargs(int ret)
+{
+	ulong flags = gd->flags;
+
+	gd->flags &= ~GD_FLG_SILENT;
+	printf("BOOT_DIAG: A72_UBOOT: after setenv bootargs\n");
+	printf("BOOT_DIAG: A72_UBOOT: setenv bootargs ret=%d\n", ret);
+	gd->flags = flags;
+}
+#endif
 
 /*
  * Maximum expected input data size for import command
  */
 #define	MAX_ENV_SIZE	(1 << 20)	/* 1 MiB */
@@ -188,10 +200,17 @@ DONE:
 static int do_env_set(struct cmd_tbl *cmdtp, int flag, int argc,
 		      char *const argv[])
 {
+	int ret;
+
 	if (argc < 2)
 		return CMD_RET_USAGE;
 
-	return env_do_env_set(flag, argc, argv, H_INTERACTIVE);
+	ret = env_do_env_set(flag, argc, argv, H_INTERACTIVE);
+#if !defined(CONFIG_XPL_BUILD) && defined(CONFIG_TARGET_J7200_A72_EVM)
+	if (!strcmp(argv[1], "bootargs"))
+		j7200_diag_bootargs(ret);
+#endif
+	return ret;
 }
 
 /*
diff --git a/cmd/part.c b/cmd/part.c
index db7bc5819c0..99aa3a0b329 100644
--- a/cmd/part.c
+++ b/cmd/part.c
@@ -21,6 +21,21 @@
 #include <part.h>
 #include <stdio.h>
 #include <vsprintf.h>
+#include <asm/global_data.h>
+
+DECLARE_GLOBAL_DATA_PTR;
+
+#if !defined(CONFIG_XPL_BUILD) && defined(CONFIG_TARGET_J7200_A72_EVM)
+static void j7200_diag_part_uuid(int ret)
+{
+	ulong flags = gd->flags;
+
+	gd->flags &= ~GD_FLG_SILENT;
+	printf("BOOT_DIAG: A72_UBOOT: after part uuid mmc 1:2 uuid\n");
+	printf("BOOT_DIAG: A72_UBOOT: part uuid ret=%d\n", ret);
+	gd->flags = flags;
+}
+#endif
 
 enum cmd_part_info {
 	CMD_PART_INFO_START = 0,
@@ -260,11 +275,20 @@ static int do_part_types(int argc, char * const argv[])
 static int do_part(struct cmd_tbl *cmdtp, int flag, int argc,
 		   char *const argv[])
 {
+	int ret;
+
 	if (argc < 2)
 		return CMD_RET_USAGE;
 
-	if (!strcmp(argv[1], "uuid"))
-		return do_part_uuid(argc - 2, argv + 2);
+	if (!strcmp(argv[1], "uuid")) {
+		ret = do_part_uuid(argc - 2, argv + 2);
+#if !defined(CONFIG_XPL_BUILD) && defined(CONFIG_TARGET_J7200_A72_EVM)
+		if (argc == 5 && !strcmp(argv[2], "mmc") &&
+		    !strcmp(argv[3], "1:2") && !strcmp(argv[4], "uuid"))
+			j7200_diag_part_uuid(ret);
+#endif
+		return ret;
+	}
 	else if (!strcmp(argv[1], "list"))
 		return do_part_list(argc - 2, argv + 2);
 	else if (!strcmp(argv[1], "start"))
diff --git a/common/autoboot.c b/common/autoboot.c
index 898a57bc92b..b4f9e3a1296 100644
--- a/common/autoboot.c
+++ b/common/autoboot.c
@@ -29,6 +29,17 @@
 
 DECLARE_GLOBAL_DATA_PTR;
 
+#if !defined(CONFIG_XPL_BUILD) && defined(CONFIG_TARGET_J7200_A72_EVM)
+static void j7200_diag_before_bootcommand(void)
+{
+	ulong flags = gd->flags;
+
+	gd->flags &= ~GD_FLG_SILENT;
+	printf("BOOT_DIAG: A72_UBOOT: before CONFIG_BOOTCOMMAND\n");
+	gd->flags = flags;
+}
+#endif
+
 #define DELAY_STOP_STR_MAX_LENGTH 64
 
 #ifndef DEBUG_BOOTKEYS
@@ -502,6 +513,9 @@ void autoboot_command(const char *s)
 		if (lock)
 			prev = disable_ctrlc(1); /* disable Ctrl-C checking */
 
+#if !defined(CONFIG_XPL_BUILD) && defined(CONFIG_TARGET_J7200_A72_EVM)
+		j7200_diag_before_bootcommand();
+#endif
 		run_command_list(s, -1, 0);
 
 		if (lock)
-- 

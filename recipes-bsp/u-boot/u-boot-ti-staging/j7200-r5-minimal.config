# R5 SPL remains an SD/FAT loader and retains TI-SCI, clocks, power, PMIC,
# DDR, firewall handling, timer instrumentation and the ARM64 remoteproc.
# Only ROM-selected recovery/alternate-media loaders are removed here.

# Suppress normal R5 SPL console messages.  UART and the R5 metric transfer
# remain compiled; this is the same SPL-only mechanism used by TI U-Boot.
CONFIG_SILENT_CONSOLE=y
CONFIG_SPL_SILENT_CONSOLE=y
CONFIG_SILENT_U_BOOT_ONLY=y
# CONFIG_SPL_BANNER_PRINT is not set

# No generic boot discovery or EFI is needed in the R5 SPL image.
# CONFIG_BOOTSTD is not set
# CONFIG_EFI_LOADER is not set

# SD/FAT primary boot requirements.
CONFIG_SPL_MMC=y
CONFIG_SPL_FS_FAT=y
CONFIG_SPL_LIBDISK_SUPPORT=y
CONFIG_SPL_LOAD_FIT=y

# Preserve the R5 -> A72 startup dependency explicitly.
CONFIG_REMOTEPROC=y
CONFIG_SPL_REMOTEPROC=y
CONFIG_REMOTEPROC_TI_K3_ARM64=y
# arch/arm/mach-k3/r5/common.c validates and loads the DM firmware as ELF
# before starting A72.  Keep the ELF library without exposing bootelf.
CONFIG_LIB_ELF=y

# Network recovery is not accepted for this experiment.
# CONFIG_CMD_NET is not set
CONFIG_NO_NET=y
# CONFIG_CMD_BOOTP is not set
# CONFIG_CMD_DHCP is not set
# CONFIG_CMD_NFS is not set
# CONFIG_CMD_PING is not set
# CONFIG_CMD_TFTPBOOT is not set
# CONFIG_CMD_PXE is not set
# CONFIG_DM_ETH is not set

# USB/DFU recovery is not accepted.
# CONFIG_CMD_USB is not set
# CONFIG_USB is not set
# CONFIG_USB_GADGET is not set
# CONFIG_SPL_USB_GADGET is not set
# CONFIG_DM_USB_GADGET is not set
# CONFIG_SPL_DM_USB_GADGET is not set
# CONFIG_USB_CDNS3 is not set
# CONFIG_SPL_USB_CDNS3_GADGET is not set
# CONFIG_CMD_DFU is not set
# CONFIG_DFU is not set
# CONFIG_SPL_DFU is not set

# UART download and RAM-device recovery loaders are not accepted.  UART
# console output itself remains enabled through SPL_SERIAL/DM_SERIAL.
# CONFIG_SPL_YMODEM_SUPPORT is not set
# CONFIG_SPL_RAM_DEVICE is not set

# OSPI/HyperFlash and other alternate-media loaders.
# CONFIG_SPL_SPI_FLASH_SUPPORT is not set
# CONFIG_SPL_SPI_FLASH_SFDP_SUPPORT is not set
# CONFIG_SPL_SPI_LOAD is not set
# CONFIG_SPL_MTD is not set
# CONFIG_SPL_NOR_SUPPORT is not set
# CONFIG_DM_SPI_FLASH is not set
# CONFIG_SPI_FLASH is not set
# CONFIG_SPL_DM_SPI is not set
# CONFIG_SPL_SPI is not set
# CONFIG_DM_SPI is not set
# CONFIG_SPI is not set
# CONFIG_MTD is not set

# R5 SPL reads only the FAT boot partition; ext4 and environment import are
# recovery/general-purpose facilities at this stage.
# CONFIG_SPL_FS_EXT4 is not set
# CONFIG_SPL_ENV_SUPPORT is not set

# Commands are not used by the SPL execution path.
# CONFIG_TI_COMMON_CMD_OPTIONS is not set
# CONFIG_CMD_BOOTFLOW is not set
# CONFIG_CMD_REMOTEPROC is not set
# CONFIG_CMD_DFU is not set
# CONFIG_CMD_ELF is not set
# CONFIG_CMD_GO is not set
# CONFIG_CMD_RUN is not set
# CONFIG_CMD_EXPORTENV is not set
# CONFIG_CMD_IMPORTENV is not set
# CONFIG_CMD_EDITENV is not set
# CONFIG_CMD_SAVEENV is not set
# CONFIG_CMD_MEMORY is not set
# CONFIG_CMD_LOADB is not set
# CONFIG_CMD_LOADS is not set
# CONFIG_CMD_PINMUX is not set
# CONFIG_CMD_SF is not set
# CONFIG_CMD_SOURCE is not set
# CONFIG_CMD_TFTPBOOT is not set

# These early safety/platform blocks are deliberately retained pending later
# hardware-specific measurements: ESM_K3, ESM_PMIC, K3_AVS0 and SPL_THERMAL.

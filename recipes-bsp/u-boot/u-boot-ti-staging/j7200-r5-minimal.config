# R5 SPL remains an SD/FAT loader and retains TI-SCI, clocks, power, PMIC,
# DDR, firewall handling, timer instrumentation and the ARM64 remoteproc.
# Only ROM-selected recovery/alternate-media loaders are removed here.

# Suppress normal R5 SPL console messages.  UART and the R5 metric transfer
# remain compiled; this is the same SPL-only mechanism used by TI U-Boot.
CONFIG_SILENT_CONSOLE=y
CONFIG_SPL_SILENT_CONSOLE=y
CONFIG_SILENT_U_BOOT_ONLY=y
# CONFIG_SPL_BANNER_PRINT is not set

# No generic boot discovery or EFI is needed in the R5 SPL image.
# CONFIG_BOOTSTD is not set
# CONFIG_EFI_LOADER is not set

# SD/FAT primary boot requirements.
CONFIG_SPL_MMC=y
CONFIG_SPL_FS_FAT=y
CONFIG_SPL_LIBDISK_SUPPORT=y
CONFIG_SPL_LOAD_FIT=y

# Preserve the R5 -> A72 startup dependency explicitly.
CONFIG_REMOTEPROC=y
CONFIG_SPL_REMOTEPROC=y
CONFIG_REMOTEPROC_TI_K3_ARM64=y
# arch/arm/mach-k3/r5/common.c validates and loads the DM firmware as ELF
# before starting A72.  Keep the ELF library without exposing bootelf.
CONFIG_LIB_ELF=y

# Fixed-board second pass: use only the compiled J7200 R5 DT.  Do not read
# board/daughtercard EEPROMs or run the multi-DTB resetup/MMC reinit path.
# CONFIG_TI_I2C_BOARD_DETECT is not set
CONFIG_OF_LIST="k3-j7200-r5-common-proc-board"
CONFIG_SPL_OF_LIST="k3-j7200-r5-common-proc-board"

# ESM, PMIC ESM, AVS voltage optimization and thermal probing are not part of
# the cold SD-to-A72 startup path.  SD's fixed/GPIO regulator framework stays.
# CONFIG_ESM_K3 is not set
# CONFIG_ESM_PMIC is not set
# CONFIG_K3_AVS0 is not set
# CONFIG_SPL_THERMAL is not set
# CONFIG_DM_THERMAL is not set
CONFIG_DM_PMIC=y
CONFIG_SPL_DM_PMIC=y
CONFIG_PMIC_CHILDREN=y
CONFIG_SPL_PMIC_CHILDREN=y
CONFIG_PMIC_TPS65941=y
# CONFIG_DM_REGULATOR_TPS65941 is not set

# Only SPL is deployed from this configuration.  Remove the unused full-U-Boot
# autoboot/parser/environment/command and non-Linux image handlers.
# CONFIG_AUTOBOOT is not set
# CONFIG_USE_BOOTCOMMAND is not set
# CONFIG_HUSH_PARSER is not set
# CONFIG_DISPLAY_BOARDINFO is not set
# CONFIG_ENV_SUPPORT is not set
# CONFIG_CMD_BDI is not set
# CONFIG_CMD_CONSOLE is not set
# CONFIG_CMD_BOOTD is not set
# SPL FIT code references SYS_BOOTM_LEN; Kconfig only defines it when one of
# the boot-image front ends is enabled.  Keep only CMD_BOOTM as that build-time
# provider; no command line is built/deployed and non-Linux handlers stay off.
CONFIG_CMD_BOOTM=y
# CONFIG_BOOTM_ELF is not set
# CONFIG_BOOTM_LINUX is not set
# CONFIG_BOOTM_NETBSD is not set
# CONFIG_BOOTM_PLAN9 is not set
# CONFIG_BOOTM_RTEMS is not set
# CONFIG_BOOTM_VXWORKS is not set
# CONFIG_CMD_FDT is not set
# CONFIG_CMD_IMI is not set
# CONFIG_CMD_XIMG is not set
# CONFIG_CMD_ENV_EXISTS is not set
# CONFIG_CMD_CRC32 is not set
# CONFIG_CMD_BIND is not set
# CONFIG_CMD_DM is not set
# CONFIG_CMD_GPT is not set
# CONFIG_CMD_MMC is not set
# CONFIG_CMD_ECHO is not set
# CONFIG_CMD_ITEST is not set
# CONFIG_CMD_BLOCK_CACHE is not set
# CONFIG_CMD_TIME is not set
# CONFIG_CMD_SLEEP is not set
# CONFIG_CMD_FAT is not set

# R5 SPL needs FIT parsing and SHA-256 hashes for tispl.bin, not full FIT
# printing/checking, other hashes, legacy crypto adapters or compression.
# CONFIG_FIT_FULL_CHECK is not set
# CONFIG_FIT_PRINT is not set
# CONFIG_SYS_BOOT_RAMDISK_HIGH is not set
# CONFIG_SHA1 is not set
# CONFIG_SPL_SHA1 is not set
# CONFIG_SHA1_LEGACY is not set
# CONFIG_SHA256_LEGACY is not set
# CONFIG_SPL_SHA1_LEGACY is not set
# CONFIG_SPL_SHA256_LEGACY is not set
# CONFIG_LEGACY_CRYPTO is not set
# CONFIG_LEGACY_CRYPTO_BASIC is not set
# CONFIG_LEGACY_CRYPTO_CERT is not set
# CONFIG_GZIP is not set

# Cold SD boot does not use eMMC boot partitions, eMMC tuning, writes, verbose
# diagnostics, full-U-Boot ext4, or FAT writes.
# CONFIG_SUPPORT_EMMC_BOOT is not set
# CONFIG_MMC_WRITE is not set
# CONFIG_MMC_HW_PARTITIONING is not set
# CONFIG_SPL_MMC_HS200_SUPPORT is not set
# CONFIG_SPL_MMC_HS400_SUPPORT is not set
# CONFIG_MMC_VERBOSE is not set
# CONFIG_FS_EXT4 is not set
# CONFIG_FAT_WRITE is not set
# CONFIG_SPL_DM_SPI_FLASH is not set

# No interactive full-U-Boot instance is deployed from the R5 build.
# CMDLINE is the Kconfig parent required to expose CMD_BOOTM/SYS_BOOTM_LEN to
# SPL FIT compilation.  Hush, editing, completion and all other commands stay
# disabled, and no R5 full-U-Boot image is deployed.
CONFIG_CMDLINE=y
# CONFIG_CMDLINE_EDITING is not set
# CONFIG_AUTO_COMPLETE is not set
# CONFIG_SYS_LONGHELP is not set
# CONFIG_SYS_XTRACE is not set
# CONFIG_CONSOLE_FLUSH_SUPPORT is not set
# CONFIG_K3_EARLY_CONS is not set
# CONFIG_EVENT is not set
# CONFIG_LAST_STAGE_INIT is not set

# Broad K3 class/platform defaults unused by the MMC/FAT, DDR, TI-SCI and A72
# remoteproc path.  SDHCI uses its own ADMA implementation.
# CONFIG_ETH is not set
# CONFIG_DMA is not set
# CONFIG_SPL_DMA is not set
# CONFIG_DMA_CHANNELS is not set
# CONFIG_TI_K3_NAVSS_UDMA is not set
# CONFIG_TI_K3_PSIL is not set
# CONFIG_TI_K3_NAVSS_RINGACC is not set
# CONFIG_INPUT is not set
# CONFIG_SYSRESET is not set
# CONFIG_SPL_SYSRESET is not set
# CONFIG_SYSRESET_CMD_RESET is not set
# CONFIG_SYSRESET_TI_SCI is not set
# CONFIG_PARTITION_UUIDS is not set
# CONFIG_SPL_PARTITION_UUIDS is not set
# CONFIG_RANDOM_UUID is not set
# CONFIG_LIB_UUID is not set
# CONFIG_SPL_LIB_UUID is not set
# CONFIG_LIB_RAND is not set
# CONFIG_SUPPORT_ACPI is not set
# CONFIG_ARCH_FIXUP_FDT_MEMORY is not set
# CONFIG_ZLIB is not set
# CONFIG_MD5 is not set
# CONFIG_MD5_LEGACY is not set
# CONFIG_CRC8 is not set
# CONFIG_TOOLS_MKEFICAPSULE is not set

# Network recovery is not accepted for this experiment.
# CONFIG_CMD_NET is not set
CONFIG_NO_NET=y
# CONFIG_CMD_BOOTP is not set
# CONFIG_CMD_DHCP is not set
# CONFIG_CMD_NFS is not set
# CONFIG_CMD_PING is not set
# CONFIG_CMD_TFTPBOOT is not set
# CONFIG_CMD_PXE is not set
# CONFIG_DM_ETH is not set

# USB/DFU recovery is not accepted.
# CONFIG_CMD_USB is not set
# CONFIG_USB is not set
# CONFIG_USB_GADGET is not set
# CONFIG_SPL_USB_GADGET is not set
# CONFIG_DM_USB_GADGET is not set
# CONFIG_SPL_DM_USB_GADGET is not set
# CONFIG_USB_CDNS3 is not set
# CONFIG_SPL_USB_CDNS3_GADGET is not set
# CONFIG_CMD_DFU is not set
# CONFIG_DFU is not set
# CONFIG_SPL_DFU is not set

# UART download and RAM-device recovery loaders are not accepted.  UART
# console output itself remains enabled through SPL_SERIAL/DM_SERIAL.
# CONFIG_SPL_YMODEM_SUPPORT is not set
# CONFIG_SPL_RAM_DEVICE is not set

# OSPI/HyperFlash and other alternate-media loaders.
# CONFIG_SPL_SPI_FLASH_SUPPORT is not set
# CONFIG_SPL_SPI_FLASH_SFDP_SUPPORT is not set
# CONFIG_SPL_SPI_LOAD is not set
# CONFIG_SPL_MTD is not set
# CONFIG_SPL_NOR_SUPPORT is not set
# CONFIG_DM_SPI_FLASH is not set
# CONFIG_SPI_FLASH is not set
# CONFIG_SPL_DM_SPI is not set
# CONFIG_SPL_SPI is not set
# CONFIG_DM_SPI is not set
# CONFIG_SPI is not set
# CONFIG_MTD is not set

# R5 SPL reads only the FAT boot partition; ext4 and environment import are
# recovery/general-purpose facilities at this stage.
# CONFIG_SPL_FS_EXT4 is not set
# CONFIG_SPL_ENV_SUPPORT is not set

# Commands are not used by the SPL execution path.
# CONFIG_TI_COMMON_CMD_OPTIONS is not set
# CONFIG_CMD_BOOTFLOW is not set
# CONFIG_CMD_REMOTEPROC is not set
# CONFIG_CMD_DFU is not set
# CONFIG_CMD_ELF is not set
# CONFIG_CMD_GO is not set
# CONFIG_CMD_RUN is not set
# CONFIG_CMD_EXPORTENV is not set
# CONFIG_CMD_IMPORTENV is not set
# CONFIG_CMD_EDITENV is not set
# CONFIG_CMD_SAVEENV is not set
# CONFIG_CMD_MEMORY is not set
# CONFIG_CMD_LOADB is not set
# CONFIG_CMD_LOADS is not set
# CONFIG_CMD_PINMUX is not set
# CONFIG_CMD_SF is not set
# CONFIG_CMD_SOURCE is not set
# CONFIG_CMD_TFTPBOOT is not set

# Required cold-boot platform blocks still include DDR, TI-SCI clocks/power,
# firewall setup, MMC/FAT, pinctrl, SD regulators, timer and A72 remoteproc.

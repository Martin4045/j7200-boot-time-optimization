# Fixed, recoverable SD-only boot path.  Partition 1:2 is the ext4 rootfs and
# contains /boot/Image plus the fixed J7200 EVM DTB.
CONFIG_USE_BOOTCOMMAND=y
CONFIG_BOOTDELAY=0
CONFIG_BOOTCOMMAND="if mmc dev 1 && part uuid mmc 1:2 uuid && load mmc 1:2 0x82000000 /boot/Image && load mmc 1:2 0x88000000 /boot/dtb/ti/k3-j7200-common-proc-board.dtb; then setenv bootargs console=ttyS2,115200n8 earlycon=ns16550a,mmio32,0x02800000 root=PARTUUID=${uuid} rw rootfstype=ext4 rootwait; booti 0x82000000 - 0x88000000; fi"

# Silence A72 SPL and full U-Boot while leaving Linux's console bootargs intact.
CONFIG_SILENT_CONSOLE=y
CONFIG_SPL_SILENT_CONSOLE=y
CONFIG_SILENT_U_BOOT_ONLY=y
# CONFIG_SPL_BANNER_PRINT is not set

# Required direct-boot primitives and minimal UART recovery shell.
CONFIG_HUSH_PARSER=y
CONFIG_CMD_BOOTI=y
CONFIG_CMD_MMC=y
CONFIG_CMD_PART=y
CONFIG_PARTITION_UUIDS=y
CONFIG_CMD_FS_GENERIC=y
CONFIG_FS_EXT4=y
# CONFIG_CMD_MEMORY is not set

# Fixed-board second pass: no EEPROM-based board matching or multi-DTB scan.
# The default and SPL DT are both the one J7200 common-proc-board DT.
# CONFIG_TI_I2C_BOARD_DETECT is not set
# Binman's TI SPL FIT generator requires this even for a one-element OF_LIST.
CONFIG_SPL_MULTI_DTB_FIT=y
# Binman requires the single fixed DT to be named in these lists even though
# board detection and alternate DT selection remain disabled.
CONFIG_OF_LIST="ti/k3-j7200-common-proc-board"
CONFIG_SPL_OF_LIST="ti/k3-j7200-common-proc-board"

# Only the raw arm64 Image path is used.  Keep FIT/SPL_FIT for TI's packaged
# boot stages, but remove full-U-Boot signature/inspection and unused OS/image
# handlers and compression codecs.
# CONFIG_ANDROID_BOOT_IMAGE is not set
# CONFIG_FIT_FULL_CHECK is not set
# CONFIG_FIT_SIGNATURE is not set
# CONFIG_FIT_PRINT is not set
# CONFIG_IMAGE_SIGN_INFO is not set
# CONFIG_SYS_BOOT_RAMDISK_HIGH is not set
# CONFIG_CMD_BOOTM is not set
# CONFIG_BOOTM_NETBSD is not set
# CONFIG_BOOTM_PLAN9 is not set
# CONFIG_BOOTM_RTEMS is not set
# CONFIG_BOOTM_VXWORKS is not set
# CONFIG_CMD_FDT is not set
# CONFIG_CMD_IMI is not set
# CONFIG_CMD_XIMG is not set
# CONFIG_CMD_CRC32 is not set
# CONFIG_RSA is not set
# CONFIG_RSA_VERIFY is not set
# CONFIG_RSA_SOFTWARE_EXP is not set
# CONFIG_SHA1 is not set
# CONFIG_SHA512 is not set
# CONFIG_SPL_SHA1 is not set
# CONFIG_SPL_SHA512 is not set
# CONFIG_SHA1_LEGACY is not set
# CONFIG_SHA256_LEGACY is not set
# CONFIG_SHA512_LEGACY is not set
# CONFIG_SPL_SHA1_LEGACY is not set
# CONFIG_SPL_SHA256_LEGACY is not set
# CONFIG_SPL_SHA512_LEGACY is not set
# CONFIG_LZ4 is not set
# CONFIG_LZMA is not set
# CONFIG_LZO is not set
# CONFIG_GZIP is not set
# CONFIG_BZIP2 is not set
# CONFIG_ZSTD is not set
# CONFIG_VPL_LZMA is not set
# CONFIG_SUPPORT_RAW_INITRD is not set
# CONFIG_ARM64_SUPPORT_AARCH32 is not set
# CONFIG_ZLIB is not set
# CONFIG_MD5 is not set
# CONFIG_MD5_LEGACY is not set
# CONFIG_CRC8 is not set

# A72 SPL does not import an environment or probe thermal/SPI-flash devices.
# CONFIG_SPL_ENV_SUPPORT is not set
# CONFIG_SPL_THERMAL is not set
# CONFIG_DM_THERMAL is not set
# CONFIG_SPL_DM_SPI is not set
# CONFIG_SPL_DM_SPI_FLASH is not set
# CONFIG_SPL_YMODEM_SUPPORT is not set

# Remove command-only diagnostics.  The boot command retains only booti, MMC,
# partition UUID and generic read-only filesystem loading.
# CONFIG_CMD_BDI is not set
# CONFIG_CMD_CONSOLE is not set
# CONFIG_CMD_BIND is not set
# CONFIG_CMD_DM is not set
# CONFIG_CMD_ECHO is not set
# CONFIG_CMD_ITEST is not set
# CONFIG_CMD_BLOCK_CACHE is not set
# CONFIG_CMD_CACHE is not set
# CONFIG_CMDLINE_EDITING is not set
# CONFIG_AUTO_COMPLETE is not set
# CONFIG_SYS_LONGHELP is not set
# CONFIG_SYS_XTRACE is not set
# CONFIG_CONSOLE_FLUSH_SUPPORT is not set

# SD is device 1.  eMMC boot partitions, eMMC HS200/HS400, writes, verbose
# diagnostics and manual speed-mode selection are outside the fixed path.
# CONFIG_SUPPORT_EMMC_BOOT is not set
# CONFIG_MMC_WRITE is not set
# CONFIG_MMC_HW_PARTITIONING is not set
# CONFIG_MMC_HS200_SUPPORT is not set
# CONFIG_SPL_MMC_HS200_SUPPORT is not set
# CONFIG_MMC_HS400_SUPPORT is not set
# CONFIG_SPL_MMC_HS400_SUPPORT is not set
# CONFIG_MMC_VERBOSE is not set
# CONFIG_MMC_SPEED_MODE_SET is not set

# Unused class/platform support left by broad K3 defaults.  The SD controller
# uses its own SDHCI ADMA path; none of these classes participates in SD boot.
# CONFIG_ETH is not set
# CONFIG_PHY is not set
# CONFIG_SPL_PHY is not set
# CONFIG_DMA is not set
# CONFIG_SPL_DMA is not set
# CONFIG_DMA_CHANNELS is not set
# CONFIG_TI_K3_NAVSS_UDMA is not set
# CONFIG_TI_K3_PSIL is not set
# CONFIG_TI_K3_NAVSS_RINGACC is not set
# CONFIG_TI_J721E_UFS is not set
# CONFIG_INPUT is not set
# CONFIG_SYSRESET is not set
# CONFIG_SPL_SYSRESET is not set
# CONFIG_SYSRESET_CMD_RESET is not set
# CONFIG_SYSRESET_TI_SCI is not set
# CONFIG_RANDOM_UUID is not set
# CONFIG_LIB_RAND is not set
# CONFIG_SUPPORT_ACPI is not set
# CONFIG_GPIO_HOG is not set
# CONFIG_SYS_REDUNDAND_ENVIRONMENT is not set
# CONFIG_LAST_STAGE_INIT is not set
# CONFIG_MISC_INIT_R is not set
# CONFIG_TOOLS_MKEFICAPSULE is not set

# Avoid board EEPROM/daughtercard/overlay and HyperFlash late fixups.  The
# fixed DTB above removes the full-U-Boot board-identification dependency.
# A72 SPL board detection remains available through TI_I2C_BOARD_DETECT.
# CONFIG_BOARD_LATE_INIT is not set
# CONFIG_DISPLAY_BOARDINFO is not set
# CONFIG_DISPLAY_CPUINFO is not set
# CONFIG_OF_BOARD_SETUP is not set
# CONFIG_OF_LIBFDT_OVERLAY is not set

# Generic boot discovery, distro/extlinux/PXE and EFI are not in this path.
# CONFIG_BOOTSTD is not set
# CONFIG_CMD_BOOTFLOW is not set
# CONFIG_CMD_BOOTDEV is not set
# CONFIG_CMD_BOOTMETH is not set
# CONFIG_CMD_VBE is not set
# CONFIG_EFI_LOADER is not set
# CONFIG_CMD_BOOTEFI is not set
# CONFIG_CMD_EFICONFIG is not set

# U-Boot networking, CPSW, MDIO and Ethernet PHY support.
# CONFIG_CMD_NET is not set
CONFIG_NO_NET=y
# CONFIG_CMD_BOOTP is not set
# CONFIG_CMD_DHCP is not set
# CONFIG_CMD_NFS is not set
# CONFIG_CMD_PING is not set
# CONFIG_CMD_TFTPBOOT is not set

# CONFIG_CMD_EXT4 is not set
# CONFIG_CMD_EXT4_WRITE is not set
# CONFIG_EXT4_WRITE is not set
# CONFIG_CMD_FAT is not set
# CONFIG_FAT_WRITE is not set


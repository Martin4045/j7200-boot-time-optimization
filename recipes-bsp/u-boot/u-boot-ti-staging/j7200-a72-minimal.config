# Fixed, recoverable SD-only boot path.  Partition 1:2 is the ext4 rootfs and
# contains /boot/Image plus the fixed J7200 EVM DTB.
CONFIG_USE_BOOTCOMMAND=y
CONFIG_BOOTDELAY=0
CONFIG_BOOTCOMMAND="if mmc dev 1 && part uuid mmc 1:2 uuid && load mmc 1:2 0x82000000 /boot/Image && load mmc 1:2 0x88000000 /boot/dtb/ti/k3-j7200-common-proc-board.dtb; then setenv bootargs console=ttyS2,115200n8 earlycon=ns16550a,mmio32,0x02800000 root=PARTUUID=${uuid} rw rootfstype=ext4 rootwait; booti 0x82000000 - 0x88000000; fi"

# Silence A72 SPL and full U-Boot while leaving Linux's console bootargs intact.
CONFIG_SILENT_CONSOLE=y
CONFIG_SPL_SILENT_CONSOLE=y
CONFIG_SILENT_U_BOOT_ONLY=y
# CONFIG_SPL_BANNER_PRINT is not set

# Required direct-boot primitives and minimal UART recovery shell.
CONFIG_HUSH_PARSER=y
CONFIG_CMD_BOOTI=y
CONFIG_CMD_MMC=y
CONFIG_CMD_PART=y
CONFIG_PARTITION_UUIDS=y
CONFIG_CMD_FS_GENERIC=y
CONFIG_FS_EXT4=y
CONFIG_CMD_MEMORY=y

# Avoid board EEPROM/daughtercard/overlay and HyperFlash late fixups.  The
# fixed DTB above removes the full-U-Boot board-identification dependency.
# A72 SPL board detection remains available through TI_I2C_BOARD_DETECT.
# CONFIG_BOARD_LATE_INIT is not set
# CONFIG_DISPLAY_BOARDINFO is not set
# CONFIG_DISPLAY_CPUINFO is not set
# CONFIG_OF_BOARD_SETUP is not set
# CONFIG_OF_LIBFDT_OVERLAY is not set

# Generic boot discovery, distro/extlinux/PXE and EFI are not in this path.
# CONFIG_BOOTSTD is not set
# CONFIG_CMD_BOOTFLOW is not set
# CONFIG_CMD_BOOTDEV is not set
# CONFIG_CMD_BOOTMETH is not set
# CONFIG_CMD_VBE is not set
# CONFIG_EFI_LOADER is not set
# CONFIG_CMD_BOOTEFI is not set
# CONFIG_CMD_EFICONFIG is not set

# U-Boot networking, CPSW, MDIO and Ethernet PHY support.
# CONFIG_CMD_NET is not set
CONFIG_NO_NET=y
# CONFIG_CMD_BOOTP is not set
# CONFIG_CMD_DHCP is not set
# CONFIG_CMD_NFS is not set
# CONFIG_CMD_PING is not set
# CONFIG_CMD_TFTPBOOT is not set
# CONFIG_CMD_PXE is not set
# CONFIG_DM_ETH is not set
# CONFIG_TI_AM65_CPSW_NUSS is not set
# CONFIG_MDIO_TI_CPSW is not set
# CONFIG_PHYLIB is not set
# CONFIG_PHY_TI is not set
# CONFIG_PHY_TI_DP83867 is not set
# CONFIG_PHY_TI_DP83869 is not set
# CONFIG_PHY_FIXED is not set

# Late auxiliary-core firmware loading is not required to enter Linux and
# reach the UART getty.  This does not affect R5 SPL's A72-start mechanism.
# CONFIG_CMD_REMOTEPROC is not set
# CONFIG_REMOTEPROC_TI_K3_R5F is not set

# USB host/gadget, DFU, fastboot and mass-storage paths.
# CONFIG_CMD_USB is not set
# CONFIG_CMD_USB_MASS_STORAGE is not set
# CONFIG_USB is not set
# CONFIG_USB_HOST is not set
# CONFIG_USB_STORAGE is not set
# CONFIG_USB_GADGET is not set

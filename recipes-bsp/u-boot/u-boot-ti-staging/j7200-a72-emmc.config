# SDK boot0: U-Boot at byte offset 0x300000.
CONFIG_SYS_MMCSD_RAW_MODE_U_BOOT_SECTOR=0x1800
CONFIG_ENV_IS_NOWHERE=y
CONFIG_CMD_ECHO=y
CONFIG_BOOTDELAY=0
# Explicit user-area selection prevents Linux reads from the boot partition.
CONFIG_BOOTCOMMAND="if j7200_mmc_bootdev && mmc dev ${boot_mmc} 0 && part uuid mmc ${boot_mmc}:2 uuid && load mmc ${boot_mmc}:2 0x82000000 /boot/Image && load mmc ${boot_mmc}:2 0x88000000 /boot/dtb/ti/k3-j7200-common-proc-board.dtb && j7200_mmc_bootdev 0x88000000; then setenv bootargs console=ttyS2,115200n8 earlycon=ns16550a,mmio32,0x02800000 root=PARTUUID=${uuid} rw rootfstype=ext4 rootwait; booti 0x82000000 - 0x88000000; fi; setenv silent; echo MMC boot failed - U-Boot console available"

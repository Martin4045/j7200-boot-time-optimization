diff --git a/arch/arm/dts/k3-j7200-common-proc-board-u-boot.dtsi b/arch/arm/dts/k3-j7200-common-proc-board-u-boot.dtsi
index 045ef17..1dca980 100644
--- a/arch/arm/dts/k3-j7200-common-proc-board-u-boot.dtsi
+++ b/arch/arm/dts/k3-j7200-common-proc-board-u-boot.dtsi
@@ -204,3 +204,25 @@
 &serdes0 {
 	bootph-all;
 };
+
+/*
+ * The 2025 upstream DT omits the HBMC subsystem configuration block at
+ * 0x47030000. The DLL/FIFO calibration status registers live there.
+ * Keep this override A72-only because the A72 SPL probes the HBMC driver.
+ */
+#ifdef CONFIG_ARM64
+&fss {
+	ranges = <0x0 0x47000000 0x0 0x47000000 0x0 0x100>,
+		 <0x0 0x47030000 0x0 0x47030000 0x0 0xc>,
+		 <0x0 0x47034000 0x0 0x47040000 0x0 0x100>,
+		 <0x0 0x47040000 0x0 0x47040000 0x0 0x100>,
+		 <0x5 0x00000000 0x5 0x00000000 0x1 0x0000000>;
+};
+
+&hbmc {
+	reg = <0x0 0x47030000 0x0 0xc>,
+	      <0x0 0x47034000 0x0 0x100>,
+	      <0x5 0x00000000 0x1 0x0000000>;
+	reg-names = "calibration", "control", "memory";
+};
+#endif

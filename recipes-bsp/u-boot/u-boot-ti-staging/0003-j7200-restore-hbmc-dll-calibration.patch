+	if (!priv->cfgregbase || !priv->mmiobase) {
+		dev_err(dev, "Failed to map HBMC calibration resources\n");
+		return -EINVAL;
+	}
+
 	if (dev_read_bool(dev, "mux-controls")) {
 		ret = am654_select_hbmc(dev);
 		if (ret) {
@@ -82,9 +161,9 @@ static int am654_hbmc_probe(struct udevice *dev)
 
 	if (!priv->calibrated) {
 		ret = am654_hyperbus_calibrate(dev);
-		if (!ret) {

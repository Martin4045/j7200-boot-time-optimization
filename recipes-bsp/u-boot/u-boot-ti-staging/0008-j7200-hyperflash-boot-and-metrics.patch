+#define HYPERBUS_CFG_DLL_STAT_REG 4
+#define HYPERBUS_CFG_MDLL_LOCK BIT(0)
+#define HYPERBUS_CFG_SDLL_LOCK BIT(1)
+#define HYPERBUS_CFG_RAM_STAT_REG 8
+#define HYPERBUS_CFG_RAM_FIFO_INIT_DONE BIT(0)
 
 struct am654_hbmc_priv {
 	void __iomem *mmiobase;
+	void __iomem *cfgregbase;
 	bool calibrated;
 };
+
+/* TI's DLL stabilization sequence: generate read traffic and check both locks. */
+static void am654_hyperbus_wait_dll(struct am654_hbmc_priv *priv)
+{
+	u16 previous[HYPERBUS_CALIB_SIZE / sizeof(u16)];
+	u16 current[HYPERBUS_CALIB_SIZE / sizeof(u16)];
+	u32 locks = HYPERBUS_CFG_MDLL_LOCK | HYPERBUS_CFG_SDLL_LOCK;
+	int pass_count = 0;
+	unsigned int sample_count = 0;
+	int j;
+	u32 status;
+
+	for (j = 0; j < ARRAY_SIZE(previous); j++)
+		previous[j] = readw(priv->mmiobase + j * sizeof(u16));
+
+	/* Wait until stable; saturate the counter for an indefinite wait. */
+	for (;;) {
+		for (j = 0; j < ARRAY_SIZE(current); j++)
+			current[j] = readw(priv->mmiobase + j * sizeof(u16));
+		status = readl(priv->cfgregbase + HYPERBUS_CFG_DLL_STAT_REG);
+		if (!memcmp(current, previous, sizeof(current)) &&
+		    (status & locks) == locks)
+			pass_count++;
+		else
+			pass_count = 0;
+		memcpy(previous, current, sizeof(current));
+		if (sample_count < HYPERBUS_DLL_MIN_READS)
+			sample_count++;
+		if (sample_count >= HYPERBUS_DLL_MIN_READS &&
+		    pass_count >= HYPERBUS_DLL_STABLE_READS)
+			return;
+	}
+}
 

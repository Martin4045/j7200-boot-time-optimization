-			break;
-	}
+		count = HYPERBUS_CALIB_COUNT;
+		pass_count = 0;
+		while (count--) {
+			qry[0] = readw(priv->mmiobase + 0x20);
+			qry[1] = readw(priv->mmiobase + 0x22);

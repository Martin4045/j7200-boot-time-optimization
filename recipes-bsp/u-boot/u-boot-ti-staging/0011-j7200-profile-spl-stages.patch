Subject: [PATCH] j7200: buffer SPL phase timestamps without additional UART output

Upstream-Status: Inappropriate [paired boot-time experiment]

diff --git a/arch/arm/lib/bootm.c b/arch/arm/lib/bootm.c
index 2d6f2c78e13..7ce22135eb2 100644
--- a/arch/arm/lib/bootm.c
+++ b/arch/arm/lib/bootm.c
@@ -21,6 +21,7 @@
 #include <dm/root.h>
 #include <env.h>
 #include <image.h>
+#include <j7200_spl_profile.h>
 #include <j7200_boot_metrics.h>
 #include <u-boot/zlib.h>
 #include <asm/byteorder.h>
@@ -96,6 +97,19 @@ static void boot_metric_add_fdt(void *fdt, u64 seed_us, u64 done_us)
 	    fdt_setprop_u64(fdt, chosen, "ti,r5-gtc-seed-us", seed_us) ||
 	    fdt_setprop_u64(fdt, chosen, "ti,bootloader-done-us", done_us))
 		printf("BOOT_METRIC: failed to publish markers in FDT\n");
+
+#if defined(CONFIG_TARGET_J7200_A72_EVM)
+	if (chosen >= 0 && readl(JP_BASE) == JP_MAGIC) {
+		fdt32_t cells[JP_COUNT + 2];
+		int i;
+
+		for (i = 0; i < JP_COUNT + 2; i++)
+			cells[i] = cpu_to_fdt32(readl(JP_BASE + 4 * i));
+		if (fdt_setprop(fdt, chosen, "ti,spl-profile-v1", cells,
+				sizeof(cells)))
+			printf("BOOT_METRIC: failed to publish SPL profile\n");
+	}
+#endif
 }
 #endif
 

 #include <asm/armv7_mpu.h>
@@ -390,6 +391,9 @@ void board_init_f(ulong dummy)
 #endif
 
 	/* init resume flag */
+	if (IS_ENABLED(CONFIG_ARM64))
+		j7200_profile_mark(JP_A72_ENTRY);
+
 	gd_set_k3_resuming(-1);
 
 	/*
@@ -546,6 +550,12 @@ void board_init_f(ulong dummy)
 		setup_navss_nb();
 
 	setup_qos();
+	if (IS_ENABLED(CONFIG_CPU_V7R)) {
+		j7200_profile_reset();
+		j7200_profile_mark(JP_R5_INIT_DONE);
+	} else {
+		j7200_profile_mark(JP_A72_INIT_DONE);
+	}
 }
 

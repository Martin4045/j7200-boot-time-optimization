diff --git a/include/j7200_spl_profile.h b/include/j7200_spl_profile.h
new file mode 100644
index 00000000000..5a4d2e4e14f
--- /dev/null
+++ b/include/j7200_spl_profile.h
@@ -0,0 +1,61 @@
+/* SPDX-License-Identifier: GPL-2.0+ */
+#ifndef __J7200_SPL_PROFILE_H
+#define __J7200_SPL_PROFILE_H
+
+#include <config.h>
+
+enum j7200_profile_slot {
+	JP_R5_INIT_DONE,
+	JP_R5_LOAD_START,
+	JP_R5_LOAD_DONE,
+	JP_R5_ARM64_REQUEST,
+	JP_A72_ENTRY,
+	JP_A72_INIT_DONE,
+	JP_A72_LOAD_START,
+	JP_A72_LOAD_DONE,
+	JP_A72_HANDOFF,
+	JP_UBOOT_ENTRY,
+	JP_COUNT
+};
+
+#if defined(CONFIG_TARGET_J7200_R5_EVM) || defined(CONFIG_TARGET_J7200_A72_EVM)
+#include <asm/io.h>
+#include <bootstage.h>
+#include <time.h>
+
+/* EEPROM occupies the scratchpad prefix; legacy metrics use the last 16B.
+ * This versioned record uses 48B at offset 384 of the 512B scratchpad.
+ * 32-bit microseconds cover cold-boot experiments shorter than 71 minutes.
+ */
+#define JP_BASE (CONFIG_SYS_K3_MCU_SCRATCHPAD_BASE + \
+		 CONFIG_SYS_K3_MCU_SCRATCHPAD_SIZE - 128)
+#define JP_MAGIC 0x53504c31
+
+static inline void j7200_profile_reset(void)
+{
+	int i;
+
+	for (i = 0; i < JP_COUNT + 2; i++)
+		writel(0, JP_BASE + 4 * i);
+	writel(JP_MAGIC, JP_BASE);
+}
+
+static inline void j7200_profile_mark(enum j7200_profile_slot slot)
+{
+	u32 us;
+
+#ifdef CONFIG_ARM64
+	us = timer_get_boot_us();
+#else
+	us = timer_get_us();
+#endif
+	writel(us, JP_BASE + 8 + 4 * slot);
+	writel(readl(JP_BASE + 4) | (1U << slot), JP_BASE + 4);
+	/* Publish before requesting execution on another core. */
+	mb();
+}
+#else
+static inline void j7200_profile_reset(void) {}
+static inline void j7200_profile_mark(enum j7200_profile_slot slot) {}
+#endif
+#endif

# Kernel and DTB read lengths are substituted from deployed artifacts.
CONFIG_BOOTDELAY=0
CONFIG_BOOTCOMMAND="if mtd read nor0 0x82000000 0x800000 @KERNEL_SIZE@; then if mtd read nor0 0x88000000 0x700000 @DTB_SIZE@; then if mmc dev 1 && part uuid mmc 1:2 uuid; then setenv bootargs console=ttyS2,115200n8 earlycon=ns16550a,mmio32,0x02800000 root=PARTUUID=${uuid} rw rootfstype=ext4 rootwait; booti 0x82000000 - 0x88000000; else echo SD root UUID lookup failed; fi; else echo HyperFlash DTB read failed; fi; else echo HyperFlash kernel read failed; fi"
CONFIG_CMD_MTD=y
CONFIG_CMD_ECHO=y
CONFIG_ENV_IS_NOWHERE=y
CONFIG_MTDIDS_DEFAULT="nor0=47034000.hyperbus"
CONFIG_MTDPARTS_DEFAULT="mtdparts=47034000.hyperbus:1m(hbmc.tiboot3),2m(hbmc.tispl),4m(hbmc.u-boot),1m(hbmc.dtb),56m(hbmc.kernel)"

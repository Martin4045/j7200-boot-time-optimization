#!/bin/sh
set -u
STATE=/var/lib/boot-benchmark
ACTIVE=$STATE/active; RUNS=$STATE/target_runs; TARGET=$STATE/target_unit; COUNT=$STATE/count
SESSION=$STATE/current_session; BOOTID=$STATE/last_boot_id; RESULTS=$STATE/results.csv; SUMMARY=$STATE/summary.txt; FAILED=$STATE/failed
LOCK=/run/boot-benchmark.lock; DEFAULT_RUNS=10; DEFAULT_TARGET=serial-getty@ttyS2.service; MAX_RUNS=1000; RETRIES=30; RETRY_DELAY=2
usage(){ echo 'Usage: boot-benchmark start [RUNS] [TARGET_UNIT]'; echo '       boot-benchmark status|results|stop'; }
root(){ [ "$(id -u)" -eq 0 ] || { echo 'boot-benchmark: must be run as root' >&2; exit 1; }; }
uint(){ case ${1-} in ''|*[!0-9]*) return 1;;*) return 0;;esac; }
write(){ printf '%s\n' "$1" >"${2}.tmp.$$" && mv "${2}.tmp.$$" "$2" || { rm -f "${2}.tmp.$$"; return 1; }; }
unlock(){ rmdir "$LOCK" 2>/dev/null||true; }
lock(){ mkdir "$LOCK" 2>/dev/null||{ echo 'boot-benchmark: another command is running' >&2; exit 1; }; trap unlock EXIT; }
settle(){ udevadm settle --timeout=30 >/dev/null 2>&1||true; }
fail(){ rm -f "$ACTIVE"; write "$1" "$FAILED"||true; disable; echo "Boot benchmark stopped: $1" >&2; exit 1; }
instance(){ e=$(systemd-escape "$1" 2>/dev/null)||return 1; printf 'boot-benchmark-collector@%s.service' "$e"; }
disable(){ systemctl disable boot-benchmark-collector.service >/dev/null 2>&1||true; [ -r "$TARGET" ]||return 0; i=$(instance "$(sed -n '1p' "$TARGET")" 2>/dev/null||true); [ -n "$i" ]&&systemctl disable "$i" >/dev/null 2>&1||true; }
validate(){ t=$1; case "$t" in *.service) ;; *) echo "boot-benchmark: target must be a .service unit" >&2; return 1;; esac; case "$t" in *,*|*'
'*) echo "boot-benchmark: target unit is not CSV-safe" >&2; return 1;; esac; l=$(systemctl show "$t" -p LoadState --value 2>/dev/null||true); case "$l" in loaded|active|inactive|activating|deactivating) return 0;; esac; echo "boot-benchmark: target unit '$t' does not exist" >&2; return 1; }
metric(){ printf '%s\n' "$2"|sed -n "s/.*BOOT_METRIC:[[:space:]]*$1=\([0-9][0-9]*\).*/\1/p"|tail -n1; }
start(){ root; n=${1-$DEFAULT_RUNS}; t=${2-$DEFAULT_TARGET}; uint "$n"&&[ "$n" -ge 1 ]&&[ "$n" -le "$MAX_RUNS" ] || { echo 'boot-benchmark: invalid RUNS' >&2; exit 2; }; validate "$t"||exit 2; rm -f "$ACTIVE"; systemctl stop boot-benchmark-collector.service >/dev/null 2>&1||true; disable; lock; install -d -m0755 "$STATE/sessions"; stamp=$(date -u +%Y%m%d-%H%M%S); name=$stamp-$t; dir=$STATE/sessions/$name; x=0; while [ -e "$dir" ]; do x=$((x+1)); dir=$STATE/sessions/$name-$x; done; install -d -m0755 "$dir/runs"; write "$name" "$SESSION"||fail 'cannot save session'; write "$t" "$TARGET"||fail 'cannot save target'; write "$n" "$RUNS"||fail 'cannot save run count'; write 0 "$COUNT"||fail 'cannot initialize counter'; rm -f "$FAILED" "$BOOTID" "$SUMMARY"; printf 'SESSION=%s\nTARGET_UNIT=%s\nRUNS=%s\n' "$name" "$t" "$n" >"$dir/metadata.txt"; printf '%s\n' 'run,boot_id,r5_gtc_seed_us,bootloader_done_us,kernel_entry_us,kernel_done_us,userspace_start_us,target_start_us,r5_phase_us,a72_uboot_us,uboot_to_kernel_entry_us,kernel_total_us,userspace_to_target_us,target_unit,clock_bridge_gtc_us,clock_bridge_monotonic_us,clock_bridge_offset_us,total_boot_to_target_us' >"$dir/boot-metrics.csv"; ln -sfn "$dir/boot-metrics.csv" "$RESULTS"; i=$(instance "$t")||fail 'cannot construct collector instance'; systemctl enable "$i" >/dev/null||fail "cannot enable $i"; write active "$ACTIVE"||fail 'cannot activate benchmark'; settle; sync; echo "Boot benchmark started: $n measured boots requested"; echo "Target: $t"; systemctl reboot||fail 'initial reboot request failed'; }
collect(){ root; lock; [ -f "$ACTIVE" ]||exit 0; [ -r "$RUNS" ]&&[ -r "$TARGET" ]&&[ -r "$SESSION" ]||fail 'persistent state missing'; nr=$(sed -n '1p' "$RUNS"); t=$(sed -n '1p' "$TARGET"); c=$(sed -n '1p' "$COUNT"); s=$(sed -n '1p' "$SESSION"); d=$STATE/sessions/$s; b=$(sed -n '1p' /proc/sys/kernel/random/boot_id); [ ! -r "$BOOTID" ]||[ "$(sed -n '1p' "$BOOTID")" != "$b" ]||exit 0; a=1; valid=0; while [ "$a" -le "$RETRIES" ]; do l=$(dmesg 2>/dev/null||true); r5=$(metric R5_GTC_SEED_US "$l"); bl=$(metric BOOTLOADER_DONE_US "$l"); ke=$(metric KERNEL_ENTRY_US "$l"); kd=$(metric KERNEL_DONE_US "$l"); bg=$(metric CLOCK_BRIDGE_GTC_US "$l"); bm=$(metric CLOCK_BRIDGE_MONOTONIC_US "$l"); us=$(systemctl show -p UserspaceTimestampMonotonic --value 2>/dev/null||true); ts=$(systemctl show "$t" -p ExecMainStartTimestampMonotonic --value 2>/dev/null||true); if uint "$r5"&&uint "$bl"&&uint "$ke"&&uint "$kd"&&uint "$bg"&&uint "$bm"&&uint "$us"&&uint "$ts"&&[ "$bl" -ge "$r5" ]&&[ "$ke" -ge "$bl" ]&&[ "$kd" -ge "$ke" ]&&[ "$bg" -ge "$kd" ]&&[ "$bg" -ge "$bm" ]&&[ "$ts" -ge "$us" ]&&[ "$ts" -ge "$bm" ]; then valid=1; break; fi; sleep "$RETRY_DELAY"; a=$((a+1)); done; [ "$valid" -eq 1 ]||fail 'required metrics unavailable or timestamp ordering invalid'; next=$((c+1)); r5_phase=$r5; a72_uboot=$((bl-r5)); handoff=$((ke-bl)); kernel_total=$((kd-ke)); userspace_target=$((ts-us)); bridge_offset=$((bg-bm)); total_boot_target=$((bg+ts-bm)); printf '%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s\n' "$next" "$b" "$r5" "$bl" "$ke" "$kd" "$us" "$ts" "$r5_phase" "$a72_uboot" "$handoff" "$kernel_total" "$userspace_target" "$t" "$bg" "$bm" "$bridge_offset" "$total_boot_target" >>"$d/boot-metrics.csv"; r=$d/runs/$(printf '%04d' "$next"); install -d -m0755 "$r"; printf 'BOOT_ID=%s\nTARGET_UNIT=%s\nR5_GTC_SEED_US=%s\nBOOTLOADER_DONE_US=%s\nKERNEL_ENTRY_US=%s\nKERNEL_DONE_US=%s\nUSERSPACE_START_US=%s\nTARGET_START_US=%s\nR5_PHASE_US=%s\nA72_UBOOT_US=%s\nUBOOT_TO_KERNEL_ENTRY_US=%s\nKERNEL_TOTAL_US=%s\nUSERSPACE_TO_TARGET_US=%s\nCLOCK_BRIDGE_GTC_US=%s\nCLOCK_BRIDGE_MONOTONIC_US=%s\nCLOCK_BRIDGE_OFFSET_US=%s\nTOTAL_BOOT_TO_TARGET_US=%s\n' "$b" "$t" "$r5" "$bl" "$ke" "$kd" "$us" "$ts" "$r5_phase" "$a72_uboot" "$handoff" "$kernel_total" "$userspace_target" "$bg" "$bm" "$bridge_offset" "$total_boot_target" >"$r/boot-summary.txt"; write "$next" "$COUNT"||fail 'cannot update counter'; write "$b" "$BOOTID"||fail 'cannot save boot id'; sync; echo "Boot benchmark sample $next/$nr recorded"; if [ "$next" -ge "$nr" ]; then rm -f "$ACTIVE" "$FAILED"; disable; awk -F, 'BEGIN{idx[1]=9;name[1]="R5_PHASE_US";idx[2]=10;name[2]="A72_UBOOT_US";idx[3]=11;name[3]="UBOOT_TO_KERNEL_ENTRY_US";idx[4]=12;name[4]="KERNEL_TOTAL_US";idx[5]=13;name[5]="USERSPACE_TO_TARGET_US";idx[6]=18;name[6]="TOTAL_BOOT_TO_TARGET_US"}NR>1{for(j=1;j<=6;j++){i=idx[j];sum[j]+=$i;if(n==0||$i<min[j])min[j]=$i;if(n==0||$i>max[j])max[j]=$i}n++}END{printf "Boot benchmark complete: %d runs\n\n",n;for(j=1;j<=6;j++)printf "%s\n  avg: %.2f us (%.3f s)\n  min: %.0f us (%.3f s)\n  max: %.0f us (%.3f s)\n%s",name[j],sum[j]/n,sum[j]/n/1000000,min[j],min[j]/1000000,max[j],max[j]/1000000,j<6?"\n":""}' "$d/boot-metrics.csv" >"$d/summary.txt"||fail 'cannot calculate summary'; ln -sfn "$d/summary.txt" "$SUMMARY"; cat "$d/summary.txt"; exit 0; fi; settle; sync; systemctl reboot||fail 'automatic reboot request failed'; }
status(){ t=unknown;s=none;n=0;c=0;[ -r "$TARGET" ]&&t=$(sed -n '1p' "$TARGET");[ -r "$SESSION" ]&&s=$(sed -n '1p' "$SESSION");[ -r "$RUNS" ]&&n=$(sed -n '1p' "$RUNS");[ -r "$COUNT" ]&&c=$(sed -n '1p' "$COUNT");[ -f "$ACTIVE" ]&&st=active||{ [ -f "$SUMMARY" ]&&st=complete||{ [ -f "$FAILED" ]&&st=stopped||st=not-started;};};echo "state: $st";echo "progress: $c/$n valid boots";echo "target: $t";echo "session: $s";echo "results: $RESULTS";[ -r "$FAILED" ]&&echo "reason: $(sed -n '1p' "$FAILED")"; }
results(){ [ -r "$RESULTS" ]&&cat "$RESULTS"||echo 'No benchmark CSV exists.'; [ -r "$SUMMARY" ]&&{ printf '\n';cat "$SUMMARY";}; }
cmd=${1-};case "$cmd" in start)[ "$#" -le 3 ]||{ usage >&2;exit 2;};start "${2-$DEFAULT_RUNS}" "${3-$DEFAULT_TARGET}";;collect)[ "$#" -eq 1 ]||exit 2;collect;;status)[ "$#" -eq 1 ]||exit 2;status;;results)[ "$#" -eq 1 ]||exit 2;results;;stop)root;rm -f "$ACTIVE";disable;write 'stopped manually' "$FAILED"||true;echo 'Boot benchmark stopped; automatic reboot is disabled.';;*)usage >&2;exit 2;;esac

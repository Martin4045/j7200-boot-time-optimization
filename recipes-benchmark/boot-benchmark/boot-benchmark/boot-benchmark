#!/bin/sh
set -u
STATE=/var/lib/boot-benchmark
ACTIVE=$STATE/active; RUNS=$STATE/target_runs; TARGET=$STATE/target_unit; COUNT=$STATE/count
SESSION=$STATE/current_session; BOOTID=$STATE/last_boot_id; RESULTS=$STATE/results.csv; SUMMARY=$STATE/summary.txt; FAILED=$STATE/failed
LOCK=/run/boot-benchmark.lock; DEFAULT_RUNS=10; DEFAULT_TARGET=netserver.service; MAX_RUNS=1000; RETRIES=30; RETRY_DELAY=2
usage(){ echo 'Usage: boot-benchmark start [RUNS] [TARGET_UNIT]'; echo '       boot-benchmark status|results|stop'; }
root(){ [ "$(id -u)" -eq 0 ] || { echo 'boot-benchmark: must be run as root' >&2; exit 1; }; }
uint(){ case ${1-} in ''|*[!0-9]*) return 1;;*) return 0;;esac; }
write(){ printf '%s\n' "$1" >"${2}.tmp.$$" && mv "${2}.tmp.$$" "$2" || { rm -f "${2}.tmp.$$"; return 1; }; }
unlock(){ rmdir "$LOCK" 2>/dev/null||true; }
lock(){ mkdir "$LOCK" 2>/dev/null||{ echo 'boot-benchmark: another command is running' >&2; exit 1; }; trap unlock EXIT; }
fail(){ rm -f "$ACTIVE"; write "$1" "$FAILED"||true; disable; echo "Boot benchmark stopped: $1" >&2; exit 1; }
instance(){ e=$(systemd-escape "$1" 2>/dev/null)||return 1; printf 'boot-benchmark-collector@%s.service' "$e"; }
disable(){ systemctl disable boot-benchmark-collector.service >/dev/null 2>&1||true; [ -r "$TARGET" ]||return 0; i=$(instance "$(sed -n '1p' "$TARGET")" 2>/dev/null||true); [ -n "$i" ]&&systemctl disable "$i" >/dev/null 2>&1||true; }
validate(){ t=$1; case "$t" in *.service|*.target) ;; *) echo "boot-benchmark: v1 supports only .service and .target units" >&2; return 1;; esac; l=$(systemctl show "$t" -p LoadState --value 2>/dev/null||true); case "$l" in loaded|active|inactive|activating|deactivating) return 0;; esac; echo "boot-benchmark: target unit '$t' does not exist" >&2; return 1; }
metric(){ printf '%s\n' "$2"|sed -n "s/.*BOOT_METRIC:[[:space:]]*$1=\([0-9][0-9]*\).*/\1/p"|tail -n1; }
start(){ root; n=${1-$DEFAULT_RUNS}; t=${2-$DEFAULT_TARGET}; uint "$n"&&[ "$n" -ge 1 ]&&[ "$n" -le "$MAX_RUNS" ] || { echo 'boot-benchmark: invalid RUNS' >&2; exit 2; }; validate "$t"||exit 2; rm -f "$ACTIVE"; systemctl stop boot-benchmark-collector.service >/dev/null 2>&1||true; disable; lock; install -d -m0755 "$STATE/sessions"; stamp=$(date -u +%Y%m%d-%H%M%S); name=$stamp-$t; dir=$STATE/sessions/$name; x=0; while [ -e "$dir" ]; do x=$((x+1)); dir=$STATE/sessions/$name-$x; done; install -d -m0755 "$dir/runs"; write "$name" "$SESSION"||fail 'cannot save session'; write "$t" "$TARGET"||fail 'cannot save target'; write "$n" "$RUNS"||fail 'cannot save run count'; write 0 "$COUNT"||fail 'cannot initialize counter'; rm -f "$FAILED" "$BOOTID" "$SUMMARY"; printf 'SESSION=%s\nTARGET_UNIT=%s\nRUNS=%s\n' "$name" "$t" "$n" >"$dir/metadata.txt"; printf '%s\n' 'run,boot_id,kernel_total_us,target_start_us,target_active_us,cutoff_us,cutoff_property' >"$dir/boot-metrics.csv"; ln -sfn "$dir/boot-metrics.csv" "$RESULTS"; i=$(instance "$t")||fail 'cannot construct collector instance'; systemctl enable "$i" >/dev/null||fail "cannot enable $i"; write active "$ACTIVE"||fail 'cannot activate benchmark'; sync; echo "Boot benchmark started: $n measured boots requested"; echo "Target: $t"; systemctl reboot||fail 'initial reboot request failed'; }
collect(){ root; lock; [ -f "$ACTIVE" ]||exit 0; [ -r "$RUNS" ]&&[ -r "$TARGET" ]&&[ -r "$SESSION" ]||fail 'persistent state missing'; nr=$(sed -n '1p' "$RUNS"); t=$(sed -n '1p' "$TARGET"); c=$(sed -n '1p' "$COUNT"); s=$(sed -n '1p' "$SESSION"); d=$STATE/sessions/$s; b=$(sed -n '1p' /proc/sys/kernel/random/boot_id); [ ! -r "$BOOTID" ]||[ "$(sed -n '1p' "$BOOTID")" != "$b" ]||exit 0; a=1; while [ "$a" -le "$RETRIES" ]; do l=$(dmesg 2>/dev/null||true); ke=$(metric KERNEL_ENTRY_US "$l"); kd=$(metric KERNEL_DONE_US "$l"); p=$(systemctl show "$t" -p ActiveEnterTimestampMonotonic -p ExecMainStartTimestampMonotonic 2>/dev/null||true); ta=$(printf '%s\n' "$p"|sed -n 's/^ActiveEnterTimestampMonotonic=//p'); ts=$(printf '%s\n' "$p"|sed -n 's/^ExecMainStartTimestampMonotonic=//p'); if uint "$ke"&&uint "$kd"&&[ "$kd" -ge "$ke" ]&&uint "$ta"&&[ "$ta" -gt 0 ]; then case "$t" in *.service) cut=$ts; cp=ExecMainStartTimestampMonotonic;; *) cut=$ta; cp=ActiveEnterTimestampMonotonic;; esac; uint "${cut-}"&&[ "$cut" -gt 0 ]&&break; fi; sleep "$RETRY_DELAY"; a=$((a+1)); done; uint "${cut-}"&&[ "$cut" -gt 0 ]||fail 'required metrics unavailable'; next=$((c+1)); total=$((kd-ke)); printf '%s,%s,%s,%s,%s,%s,%s\n' "$next" "$b" "$total" "$ts" "$ta" "$cut" "$cp" >>"$d/boot-metrics.csv"; r=$d/runs/$(printf '%04d' "$next"); install -d -m0755 "$r"; printf 'BOOT_ID=%s\nTARGET_UNIT=%s\nCUTOFF_PROPERTY=%s\nKERNEL_TOTAL_US=%s\nTARGET_START_US=%s\nTARGET_ACTIVE_US=%s\nCUTOFF_US=%s\n' "$b" "$t" "$cp" "$total" "$ts" "$ta" "$cut" >"$r/boot-summary.txt"; write "$next" "$COUNT"||fail 'cannot update counter'; write "$b" "$BOOTID"||fail 'cannot save boot id'; sync; echo "Boot benchmark sample $next/$nr recorded"; if [ "$next" -ge "$nr" ]; then rm -f "$ACTIVE" "$FAILED"; disable; awk -F, 'NR>1{s+=$3; if(NR==2||$3<mi)mi=$3;if(NR==2||$3>ma)ma=$3;n++}END{printf "Boot benchmark complete: %d runs\\n\\nKERNEL_TOTAL_US\\n  avg: %.2f\\n  min: %.0f\\n  max: %.0f\\n",n,s/n,mi,ma}' "$d/boot-metrics.csv" >"$d/summary.txt"||fail 'cannot calculate summary'; ln -sfn "$d/summary.txt" "$SUMMARY"; cat "$d/summary.txt"; exit 0; fi; systemctl reboot||fail 'automatic reboot request failed'; }
status(){ t=unknown;s=none;n=0;c=0;[ -r "$TARGET" ]&&t=$(sed -n '1p' "$TARGET");[ -r "$SESSION" ]&&s=$(sed -n '1p' "$SESSION");[ -r "$RUNS" ]&&n=$(sed -n '1p' "$RUNS");[ -r "$COUNT" ]&&c=$(sed -n '1p' "$COUNT");[ -f "$ACTIVE" ]&&st=active||{ [ -f "$SUMMARY" ]&&st=complete||{ [ -f "$FAILED" ]&&st=stopped||st=not-started;};};echo "state: $st";echo "progress: $c/$n valid boots";echo "target: $t";echo "session: $s";echo "results: $RESULTS";[ -r "$FAILED" ]&&echo "reason: $(sed -n '1p' "$FAILED")"; }
results(){ [ -r "$RESULTS" ]&&cat "$RESULTS"||echo 'No benchmark CSV exists.'; [ -r "$SUMMARY" ]&&{ printf '\n';cat "$SUMMARY";}; }
cmd=${1-};case "$cmd" in start)[ "$#" -le 3 ]||{ usage >&2;exit 2;};start "${2-$DEFAULT_RUNS}" "${3-$DEFAULT_TARGET}";;collect)[ "$#" -eq 1 ]||exit 2;collect;;status)[ "$#" -eq 1 ]||exit 2;status;;results)[ "$#" -eq 1 ]||exit 2;results;;stop)root;rm -f "$ACTIVE";disable;write 'stopped manually' "$FAILED"||true;echo 'Boot benchmark stopped; automatic reboot is disabled.';;*)usage >&2;exit 2;;esac

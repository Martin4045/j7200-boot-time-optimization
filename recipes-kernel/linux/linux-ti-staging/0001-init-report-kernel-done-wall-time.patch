From 0000000000000000000000000000000000000002 Mon Sep 17 00:00:00 2001
From: SDK User <sdk-user@example.com>
Date: Wed, 29 Jul 2026 12:00:01 +0900
Subject: [PATCH] init: report kernel-done wall time on arm64

Read the architected counter after the kernel reaches SYSTEM_RUNNING and
report its value in microseconds. On J7200 the R5 bootloader seeds the GTC
with the elapsed R5 SPL time, so this is continuous across R5, A72 U-Boot,
and Linux.

Upstream-Status: Inappropriate [shared boot-time measurement]
---
 init/main.c | 20 ++++++++++++++++++++
 1 file changed, 20 insertions(+)

diff --git a/init/main.c b/init/main.c
index 821df1f05..6c696b4d7 100644
--- a/init/main.c
+++ b/init/main.c
@@ -102,6 +102,10 @@
 #include <linux/randomize_kstack.h>
 #include <linux/pidfs.h>
 #include <linux/ptdump.h>
+#if defined(CONFIG_ARM64) && defined(CONFIG_ARM_ARCH_TIMER)
+#include <linux/math64.h>
+#include <clocksource/arm_arch_timer.h>
+#endif
 #include <net/net_namespace.h>
 
 #include <asm/io.h>
@@ -1501,6 +1505,22 @@ static int __ref kernel_init(void *unused)
 
 	rcu_end_inkernel_boot();
 
+#if defined(CONFIG_ARM64) && defined(CONFIG_ARM_ARCH_TIMER)
+	{
+		u32 counter_rate = arch_timer_get_rate();
+
+		if (counter_rate) {
+			u64 boot_us;
+
+			boot_us = mul_u64_u32_div(arch_timer_read_counter(),
+						  USEC_PER_SEC,
+						  counter_rate);
+			pr_info("BOOT_METRIC: KERNEL_DONE_US=%llu\n",
+				(unsigned long long)boot_us);
+		}
+	}
+#endif
+
 	do_sysctl_args();
 
 	if (ramdisk_execute_command) {
